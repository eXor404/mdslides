---
// Inline render of the mdslides mark (matches public/favicon.svg and
// app/public/favicon.svg): a slide card with two text lines. Each instance
// gets a unique gradient id so multiple logos on one page don't collide.
// The card frame follows the site theme via var(--bg).
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = '' } = Astro.props;
const gid = `logo-grad-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['brand-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 28 28"
  fill="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ff0080" />
      <stop offset="50%" stop-color="#ff4500" />
      <stop offset="100%" stop-color="#ffa500" />
    </linearGradient>
  </defs>
  <rect x="0" y="0" width="28" height="28" rx="7" fill="#0d0d0d" />
  <rect x="7" y="9" width="14" height="2.6" rx="1.3" fill={`url(#${gid})`} />
  <rect x="7" y="13.2" width="14" height="2.6" rx="1.3" fill={`url(#${gid})`} />
  <rect x="7" y="17.4" width="9" height="2.6" rx="1.3" fill={`url(#${gid})`} />
</svg>

<style>
  .brand-mark {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }
</style>
